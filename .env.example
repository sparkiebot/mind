# Use "stub" for local API tests without model weights. Use "gemma" in production.
MIND_RUNTIME=stub
MIND_MODEL_ID=google/gemma-3n-E2B-it
MIND_DEVICE=auto
MIND_PRECISION=bfloat16
MIND_BIND_HOST=127.0.0.1
MIND_PORT=8088
MIND_MAX_GENERATED_TOKENS=256
MIND_TEMPERATURE=0.2
MIND_REQUEST_TIMEOUT_SECONDS=45
MIND_MAX_AUDIO_DURATION_SECONDS=30
MIND_MAX_UPLOAD_BYTES=5242880
MIND_QUEUE_LENGTH=0
MIND_DEBUG_RETAIN_AUDIO=false
MIND_DEBUG_AUDIO_DIR=debug-audio
