# Use "stub" for local API tests without llama-server. Use "llama-server" in production.
MIND_RUNTIME=llama-server
# External llama.cpp runtime. Start llama-server separately and keep it on loopback.
MIND_LLAMA_SERVER_URL=http://127.0.0.1:8080
MIND_LLAMA_SERVER_MODEL=gemma4-e2b
# Optional local-stack script overrides (scripts/run-llama-mind.sh).
# MIND_LLAMA_MODEL_PATH=models/llama.cpp/gemma4-e2b/google-gemma-4-E2B-it-Q4_K_M.gguf
# MIND_LLAMA_MMPROJ_PATH=models/llama.cpp/gemma4-e2b/mmproj-BF16.gguf
# MIND_LLAMA_GPU_LAYERS=99
# MIND_LLAMA_CONTEXT_SIZE=4096
# MIND_LLAMA_PARALLEL=1
MIND_BIND_HOST=127.0.0.1
MIND_PORT=8088
MIND_MAX_GENERATED_TOKENS=256
MIND_TEMPERATURE=0.2
MIND_REQUEST_TIMEOUT_SECONDS=45
MIND_MAX_AUDIO_DURATION_SECONDS=30
MIND_MAX_UPLOAD_BYTES=5242880
MIND_MAX_TEXT_LENGTH=4000
MIND_QUEUE_LENGTH=0
MIND_DEBUG_RETAIN_AUDIO=false
MIND_DEBUG_AUDIO_DIR=debug-audio
